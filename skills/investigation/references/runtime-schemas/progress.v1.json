{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://groundwork.local/runtime-schemas/progress.v1.json",
  "title": "AINS progress v1",
  "description": "Documentation only. The authoritative validator is scripts/ains_runtime/contracts.py (stdlib, no jsonschema dependency); where this document and the code disagree, the code wins and this file is a bug. Written by the runtime only.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    },
    {
      "properties": {
        "schema": {
          "const": "ains.progress/v1"
        },
        "body": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "at"
          ],
          "properties": {
            "state": {
              "enum": [
                "accepted",
                "running",
                "waiting_for_answer",
                "completed",
                "rejected",
                "failed",
                "cancelled",
                "cancel_requested",
                "recovery_required"
              ]
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "invocation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "detail": {
              "oneOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "x-examples": [
    "examples/progress.json"
  ]
}
